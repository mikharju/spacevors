{
  "name": "SpaceSurvivors C# Development",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "agent",

  "workspaceFolder": "/workspace",

  "postCreateCommand": "dotnet --version && dotnet restore",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  },

  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  }
}